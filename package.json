{
  "name": "wemby",
  "version": "1.0.0",
  "description": "wemby — 轻量级 Emby 桌面播放器（默认浅色主题）",
  "main": "main.js",
  "author": "wemby",
  "license": "MIT",
  "keywords": [
    "emby",
    "media-player",
    "electron",
    "desktop-app",
    "video-player",
    "hls",
    "streaming",
    "react",
    "typescript",
    "cross-platform",
    "media-server-client"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:win": "cross-env NODE_ENV=production vite build && electron-builder --win"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.0",
    "@reduxjs/toolkit": "^1.9.5",
    "antd": "^5.7.0",
    "axios": "^1.4.0",
    "crypto-js": "^4.1.1",
    "hls.js": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "video.js": "^8.4.0",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.1.1",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^25.5.0",
    "electron-builder": "^24.6.3",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "typescript": "^5.1.6",
    "vite": "^4.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.wemby.desktopplayer",
    "productName": "wemby",
    "directories": {
      "output": "dist_electron",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "wemby",
      "artifactName": "wemby-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "wemby-Portable-${version}.${ext}"
    }
  }
}
